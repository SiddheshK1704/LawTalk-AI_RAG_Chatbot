{
    "name": "lawtalk-frontend",
    "version": "1.0.0",
    "description": "AI Legal Assistant Frontend",
    "scripts": {
        "build:css": "npx tailwindcss -i ./src/input.css -o ./dist/style.css --minify",
        "watch:css": "npx tailwindcss -i ./src/input.css -o ./dist/style.css --watch",
        "dev": "npm run watch:css"
    },
    "devDependencies": {
        "autoprefixer": "^10.4.27",
        "live-server": "^1.2.2",
        "postcss": "^8.5.8",
        "tailwindcss": "^3.4.19"
    }
}
